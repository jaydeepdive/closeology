# large raw data — re-fetched by build_all (data/keep is kept; see negation below)
data/*/*.parquet
data/*/*.csv
data/*/*.accdb
data/*/*.zip
data/*/*.chm
data/*/out/
data/qc/_gpkg/
data/on/
data/minfile_db/
!data/keep/**
# large generated site assets — rebuilt in CI + published via the Pages artifact.
# Keep only the lightweight core pages (priority + hub) tracked for reference.
site/*.html
!site/index.html
!site/priorities.html
!site/regions.html
site/app_artifact.html
site/*.geojson
site/*.png
__pycache__/
*.pyc
src/access_parser/
