# large raw data — re-fetched by build_all (data/keep is kept; see negation below)
data/*/*.parquet
data/*/*.csv
data/*/*.accdb
data/*/*.zip
data/*/*.chm
data/*/out/
data/qc/_gpkg/
data/on/
data/minfile_db/
!data/keep/**
# MMP raw store exceeds GitHub's 100 MB file limit and is regenerated weekly by
# the mmp-backbone workflow from the live gov sources — keep only the parquet exports.
data/keep/mmp.sqlite
# large generated site assets — rebuilt in CI + published via the Pages artifact.
# Keep only the lightweight core pages (priority + hub) tracked for reference.
# generated site pages ARE committed so the fast deploy.yml (which uploads only
# the committed site/) serves a COMPLETE site — app.html / yk.html / province
# maps / radar were being 404'd because they were ignored and thus never in the
# fast-deploy artifact. Only the private artifact variant stays ignored.
site/app_artifact.html
# site/*.geojson are the MAP LAYERS (open ground, staked claims, drill holes) —
# they MUST be committed or the fast deploy serves a layerless map (just dots).
# (large intermediate geojson, if any, can be ignored individually below.)
site/*.png
__pycache__/
*.pyc
src/access_parser/

# SEDAR PDFs are retained in the report-archive release, not git
data/keep/sedar_pdfs/
data/keep/sedar_profile/
data/keep/sedar_batch.log
data/keep/sedar_launchd.out
data/keep/sedar_launchd.err
data/keep/sedar_debug_last.html
data/keep/sedar_cursor.json
data/keep/mmp_reextract.sqlite
data/keep/ocr_cache/
data/keep/mmp_reextract.sqlite-journal
*.sqlite-journal
